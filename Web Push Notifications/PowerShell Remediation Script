<#
.SYNOPSIS
    Consolidated remediation for rogue push notifications and scareware in Microsoft Edge and Google Chrome.
.DESCRIPTION
    1. Terminates running browser processes to release LevelDB file locks.
    2. Enforces HKLM enterprise policies (DefaultNotificationsSetting = 2) to block all site push requests.
    3. Traverses every user profile on the machine and wipes Service Worker and Platform Notifications storage.
#>

[CmdletBinding()]
param()

$Browsers = @(
    @{
        Name       = "Microsoft Edge"
        Process    = "msedge"
        PolicyPath = "HKLM:\SOFTWARE\Policies\Microsoft\Edge"
        UserData   = "AppData\Local\Microsoft\Edge\User Data"
    },
    @{
        Name       = "Google Chrome"
        Process    = "chrome"
        PolicyPath = "HKLM:\SOFTWARE\Policies\Google\Chrome"
        UserData   = "AppData\Local\Google\Chrome\User Data"
    }
)

# Step 1: Kill browser processes
Write-Output "[*] Terminating active browser instances..."
foreach ($browser in $Browsers) {
    $running = Get-Process -Name $browser.Process -ErrorAction SilentlyContinue
    if ($running) {
        $running | Stop-Process -Force
        Write-Output "    [-] Killed $($browser.Name) ($($browser.Process).exe)"
    }
}
Start-Sleep -Seconds 2

# Step 2: Apply enterprise registry policies
Write-Output "[*] Applying enterprise lockdown policies (DefaultNotificationsSetting = 2)..."
foreach ($browser in $Browsers) {
    if (-not (Test-Path $browser.PolicyPath)) {
        New-Item -Path $browser.PolicyPath -Force | Out-Null
    }
    Set-ItemProperty -Path $browser.PolicyPath -Name "DefaultNotificationsSetting" -Value 2 -Type DWord -Force
    Write-Output "    [+] Policy enforced: $($browser.PolicyPath)"
}

# Step 3: Purge persistent notification storage across all user profiles
Write-Output "[*] Purging notification storage across user profiles..."
$userProfiles = Get-ChildItem "C:\Users" -Directory | Where-Object { $_.Name -notmatch '^(Public|Default|All Users)$' }

foreach ($user in $userProfiles) {
    foreach ($browser in $Browsers) {
        $userDataPath = Join-Path $user.FullName $browser.UserData
        
        if (Test-Path $userDataPath) {
            $profiles = Get-ChildItem -Path $userDataPath -Directory | Where-Object { $_.Name -eq "Default" -or $_.Name -like "Profile *" }
            
            foreach ($profile in $profiles) {
                # Clear Service Workers (background push engines)
                $swPath = Join-Path $profile.FullName "Service Worker"
                if (Test-Path $swPath) {
                    Remove-Item -Path $swPath -Recurse -Force -ErrorAction SilentlyContinue
                    Write-Output "    [-] Purged Service Worker: $swPath"
                }

                # Clear Platform Notifications (cached notification database)
                $pnPath = Join-Path $profile.FullName "Platform Notifications"
                if (Test-Path $pnPath) {
                    Remove-Item -Path $pnPath -Recurse -Force -ErrorAction SilentlyContinue
                    Write-Output "    [-] Purged Platform Notifications: $pnPath"
                }
            }
        }
    }
}

Write-Output "[+] Remediation successfully completed for Edge and Chrome."
